PORT=3000
DB_PATH=data/keepwarm.db
# Require a password for the dashboard and API (any username).
DASHBOARD_PASSWORD=
# Services to create on startup: url=minutes, comma-separated.
SEED_MONITORS=https://md-to-pdf-zckb.onrender.com/=10,https://things-to-do-xdmm.onrender.com/=10
# Slack or Discord incoming webhook for down/recovered alerts.
ALERT_WEBHOOK_URL=
COLD_START_THRESHOLD_MS=10000
RETENTION_DAYS=7
REQUEST_TIMEOUT_MS=90000
MIN_INTERVAL_MINUTES=1
MAX_INTERVAL_MINUTES=60
MAX_MONITORS=50
# Allow non-*.onrender.com URLs (only on private instances).
ALLOW_ANY_HOST=false
# Defaults to $RENDER_EXTERNAL_URL/healthz on Render.
SELF_PING_URL=
